{
  "name": "@goshenignite/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Goshenignite Inventory desktop app for Windows",
  "main": "src/main.js",
  "scripts": {
    "prepare:resources": "node scripts/prepare-resources.js",
    "start": "electron .",
    "dist:win": "npm run prepare:resources && electron-builder --win"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.goshenignite.inventory",
    "productName": "Goshenignite Inventory",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["src/**/*", "package.json"],
    "asar": false,
    "extraResources": [
      { "from": "vendor/resources/node_modules", "to": "node_modules" },
      { "from": "vendor/resources/backend", "to": "backend" },
      { "from": "vendor/resources/frontend", "to": "frontend" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GoshenigniteInventorySetup.exe"
    }
  }
}
